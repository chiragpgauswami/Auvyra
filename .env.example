# ==============================================================================
# AUVYRA CONFIGURATION TEMPLATE
# Copy to .env and fill in required values for your deployment
# NEVER commit .env to version control
# ==============================================================================

# Application
APP_NAME=Auvyra
APP_ENV=development
APP_DEBUG=false
APP_HOST=0.0.0.0
APP_PORT=8000
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173
API_URL=http://localhost:8000/api

# Security & Authentication
# In production, JWT_SECRET_KEY must be a secure random 32+ character string
JWT_SECRET_KEY=change-this-to-a-secure-random-32-char-secret-in-production
JWT_REFRESH_SECRET_KEY=change-this-to-another-secure-random-32-char-secret
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
# 32-byte URL-safe base64 Fernet key for encrypting OAuth tokens at rest
FERNET_ENCRYPTION_KEY=
COOKIE_SECURE=false
COOKIE_SAMESITE=lax

# MongoDB Database
# Supports local mongodb://localhost:27017 or MongoDB Atlas mongodb+srv://...
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=auvyra
MONGODB_TEST_DATABASE=auvyra_test

# Ollama (Local AI Gateway)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_TIMEOUT_SECONDS=60.0

# Google OAuth & YouTube Integration
# Obtain from Google Cloud Console -> APIs & Services -> Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback
YOUTUBE_API_KEY=

# Storage & Media
MEDIA_STORAGE_PROVIDER=local
MEDIA_ROOT=media

# Video Rendering & FFmpeg
FFMPEG_PATH=
FFPROBE_BINARY=
VIDEO_WIDTH=1080
VIDEO_HEIGHT=1920
VIDEO_FPS=30

# Text to Speech (Edge TTS)
EDGE_TTS_VOICE=en-US-AriaNeural
EDGE_TTS_RATE=1.0

# Background Workers
WORKER_POLL_INTERVAL=2.0
WORKER_STALE_TIMEOUT=15

# Optional Third-Party Media & Research Providers
PEXELS_API_KEY=
RESEARCH_PROVIDERS=
